# ==============================================================================
# ESP32-CAM Precision Vital Signs Station: ECG + PPG + Blood Pressure (PTT)
# ==============================================================================
# Target Board: AI-Thinker ESP32-CAM
# Firmware: micropython_camera_feeeb5ea3_esp32_idf4_4.bin
#
# Hardware Pinout:
# - AD8232 ECG Output   -> ESP32 GPIO 2 (ADC2_CH2 - Pin 7 on Left Header)
# - MAX30102 I2C (0x57) -> SCL: GPIO 14 (Left Pin 4) | SDA: GPIO 13 (Left Pin 6)
# - LCD 1602 I2C (0x27) -> SCL: GPIO 14 (Shared)     | SDA: GPIO 13 (Shared)
# ==============================================================================

import time
import math
from machine import Pin, ADC, SoftI2C

LCD_ADDR_CANDIDATES = [0x27, 0x3F]
MAX30102_ADDR       = 0x57

REG_FIFO_WR_PTR = 0x04
REG_FIFO_OV_CTR = 0x05
REG_FIFO_RD_PTR = 0x06
REG_FIFO_DATA   = 0x07
REG_FIFO_CONFIG = 0x08
REG_MODE_CONFIG = 0x09
REG_SPO2_CONFIG = 0x0A
REG_LED1_PA     = 0x0C
REG_LED2_PA     = 0x0D
REG_PART_ID     = 0xFF

# ==============================================================================
# 1. Embedded LCD 1602 I2C Driver (PCF8574 Backpack)
# ==============================================================================

class I2cLcd1602:
    MASK_RS = 0x01
    MASK_RW = 0x02
    MASK_EN = 0x04
    MASK_BL = 0x08

    def __init__(self, i2c, addr=0x27):
        self.i2c = i2c
        self.addr = addr
        self.backlight = self.MASK_BL
        time.sleep_ms(50)
        self._write_nibble(0x03 << 4)
        time.sleep_ms(5)
        self._write_nibble(0x03 << 4)
        time.sleep_us(150)
        self._write_nibble(0x03 << 4)
        time.sleep_ms(1)
        self._write_nibble(0x02 << 4)
        
        self.cmd(0x28)  # 4-bit mode, 2 lines, 5x8 dots
        self.cmd(0x0C)  # Display ON, cursor OFF, blink OFF
        self.cmd(0x06)  # Entry mode: increment cursor
        self.clear()
        
        # Custom Character 0: Solid Beating Heart
        heart_solid = [0b00000, 0b01010, 0b11111, 0b11111, 0b01110, 0b00100, 0b00000, 0b00000]
        self.create_char(0, heart_solid)

    def _write_byte(self, data):
        try:
            self.i2c.writeto(self.addr, bytes([data | self.backlight]))
        except Exception:
            pass

    def _write_nibble(self, nibble, mode=0):
        self._write_byte(nibble | mode | self.MASK_EN)
        time.sleep_us(1)
        self._write_byte(nibble | mode)
        time.sleep_us(50)

    def _send(self, value, mode=0):
        self._write_nibble(value & 0xF0, mode)
        self._write_nibble((value << 4) & 0xF0, mode)

    def cmd(self, command):
        self._send(command, 0)
        if command in [0x01, 0x02]:
            time.sleep_ms(2)

    def clear(self):
        self.cmd(0x01)

    def set_cursor(self, col, row):
        addr = col + (0x40 if row == 1 else 0x00)
        self.cmd(0x80 | addr)

    def write_str(self, s):
        for ch in s:
            self._send(ord(ch), self.MASK_RS)

    def write_custom(self, location):
        self._send(location, self.MASK_RS)

    def create_char(self, location, pattern):
        location &= 0x07
        self.cmd(0x40 | (location << 3))
        for line in pattern:
            self._send(line, self.MASK_RS)
        self.cmd(0x80)

# ==============================================================================
# 2. MAX30102 Hardware Register Driver
# ==============================================================================

class MAX30102:
    def __init__(self, i2c, address=MAX30102_ADDR):
        self.i2c = i2c
        self.address = address
        part_id = self.read_reg(REG_PART_ID)[0]
        if part_id != 0x15:
            print("[WARN] Unexpected MAX30102 Part ID: 0x%02X" % part_id)
        else:
            print("[OK] MAX30102 Verified: Part ID 0x%02X" % part_id)
        self.reset()
        self.setup()

    def write_reg(self, reg, val):
        try:
            self.i2c.writeto_mem(self.address, reg, bytes([val]))
        except Exception:
            pass

    def read_reg(self, reg, num_bytes=1):
        try:
            return self.i2c.readfrom_mem(self.address, reg, num_bytes)
        except Exception:
            return bytes([0] * num_bytes)

    def reset(self):
        self.write_reg(REG_MODE_CONFIG, 0x40)
        time.sleep_ms(20)

    def setup(self):
        # SMP_AVE = 4 samples averaged, FIFO Rollover enabled (0x50)
        self.write_reg(REG_FIFO_CONFIG, 0x50)
        # Dual Red + IR mode (0x03)
        self.write_reg(REG_MODE_CONFIG, 0x03)
        # 100 Hz rate, 4096nA range, 18-bit (25.0 Hz output = 40.0 ms / sample)
        self.write_reg(REG_SPO2_CONFIG, 0x27)
        # Tissue-compensated LED drive currents (calibrated for thumb pad):
        self.write_reg(REG_LED1_PA, 0x2C)  # RED LED (~8.8 mA)
        self.write_reg(REG_LED2_PA, 0x28)  # IR LED  (~8.0 mA)
        self.clear_fifo()

    def clear_fifo(self):
        self.write_reg(REG_FIFO_WR_PTR, 0x00)
        self.write_reg(REG_FIFO_OV_CTR, 0x00)
        self.write_reg(REG_FIFO_RD_PTR, 0x00)

    def available(self):
        try:
            wr = self.read_reg(REG_FIFO_WR_PTR)[0]
            rd = self.read_reg(REG_FIFO_RD_PTR)[0]
            return (wr - rd) & 0x1F
        except Exception:
            return 0

    def read_sample(self):
        try:
            raw = self.read_reg(REG_FIFO_DATA, 6)
            if len(raw) < 6:
                return None, None
            red = ((raw[0] << 16) | (raw[1] << 8) | raw[2]) & 0x03FFFF
            ir  = ((raw[3] << 16) | (raw[4] << 8) | raw[5]) & 0x03FFFF
            return red, ir
        except Exception:
            return None, None

# ==============================================================================
# 3. AD8232 ECG Sensor Interface & R-Peak Detector (GPIO 2 / ADC2_CH2)
# ==============================================================================

class EcgEngine:
    def __init__(self, adc_pin=2):
        self.adc = ADC(Pin(adc_pin))
        self.adc.atten(ADC.ATTN_11DB)   # Full scale range 0 - 3.3V
        self.adc.width(ADC.WIDTH_12BIT) # 0 - 4095 counts
        self.baseline = 1960.0
        self.ecg_ac_peak = 90.0
        self.prev_val = 1960
        self.prev_slope = 0
        self.last_r_peak_ms = None
        self.last_lead_status = False
        self.lead_off_count = 0
        self.r_peak_count = 0
        self.rr_intervals = []
        self.ecg_bpm = None

    def read_filtered(self):
        """Oversamples 3 times to eliminate transient ADC2 zeros and noise."""
        total = 0
        valid = 0
        for _ in range(3):
            v = self.adc.read()
            if v > 0:
                total += v
                valid += 1
        if valid > 0:
            return total // valid
        return 0

    def sample(self, now_ms):
        """Reads ADC and detects ventricular R-peaks with adaptive crest detection."""
        raw = self.read_filtered()
        if raw == 0:
            return self.prev_val, False, self.last_lead_status

        # Persistent saturation filter: requires >20 consecutive samples of solid rail saturation
        if raw >= 4090 or raw <= 25:
            self.lead_off_count += 1
            if self.lead_off_count >= 20:
                self.last_lead_status = False
        else:
            self.lead_off_count = 0
            self.last_lead_status = True
        
        # Fast DC baseline tracking (~1.65V virtual ground, around 1880 - 2040)
        self.baseline = 0.95 * self.baseline + 0.05 * float(raw)
        ecg_ac = float(raw) - self.baseline
        
        # Track AC amplitude dynamically
        if ecg_ac > 0:
            self.ecg_ac_peak = max(35.0, max(self.ecg_ac_peak * 0.985, ecg_ac))
            
        slope = raw - self.prev_val
        self.prev_val = raw

        # Adaptive threshold: 45% of running crest height (min 35 counts)
        dynamic_thresh = max(35.0, self.ecg_ac_peak * 0.45)

        # Detect R-peak inflection crest with 380ms refractory lockout
        is_r_peak = False
        refractory_ok = (self.last_r_peak_ms is None) or (time.ticks_diff(now_ms, self.last_r_peak_ms) > 380)
        
        if refractory_ok and ecg_ac > dynamic_thresh and self.prev_slope > 0 and slope <= 0:
            is_r_peak = True
            self.r_peak_count += 1
            if self.last_r_peak_ms is not None:
                rr_ms = time.ticks_diff(now_ms, self.last_r_peak_ms)
                if 400 <= rr_ms <= 1600:  # 37 - 150 BPM
                    instant_bpm = 60000.0 / rr_ms
                    self.rr_intervals.append(instant_bpm)
                    if len(self.rr_intervals) > 5:
                        self.rr_intervals.pop(0)
                    self.ecg_bpm = sum(self.rr_intervals) / len(self.rr_intervals)
            self.last_r_peak_ms = now_ms

        self.prev_slope = slope
        return raw, is_r_peak, self.last_lead_status

# ==============================================================================
# 4. Precision Vitals & Pulse Transit Time (PTT) Blood Pressure Engine
# ==============================================================================

class VitalsAndBPEngine:
    SAMPLE_PERIOD_MS = 40  # 25.0 Hz hardware FIFO = 40.0 ms / sample

    def __init__(self):
        # Calibrated Moens-Korteweg coefficients:
        # SBP = a * ln(PTT_ms) + b
        # DBP = c * ln(PTT_ms) + d
        # Baseline: PTT=260ms -> SBP=117, DBP=77 mmHg
        self.cal_a = -72.5
        self.cal_b = 518.0
        self.cal_c = -48.0
        self.cal_d = 343.0

        self.reset()

    def reset(self):
        self.sample_idx = 0
        self.ir_dc = None
        self.red_dc = None
        self.ac_smooth = 0.0
        self.prev_ac = 0.0
        self.prev_ac2 = 0.0
        self.last_peak_sample = None
        self.beat_count = 0
        self.bpm_history = []
        self.current_bpm = None
        self.current_spo2 = None
        self.ir_ac_peak = 80.0
        self.red_ac_peak = 80.0
        self.finger_present = False
        self.absent_count = 0

        # PTT and Blood Pressure tracking
        self.ptt_history = []
        self.current_ptt_ms = None
        self.current_sbp = None
        self.current_dbp = None

    def process_ppg(self, red, ir, last_r_peak_ms, now_ms):
        """Processes MAX30102 PPG frame and computes PTT when synchronized with ECG."""
        self.sample_idx += 1

        # 1. Robust Hysteresis & Debounced Finger Presence Verification
        # Tissue presence is positive if IR > 18000 or Red > 12000 counts
        sample_has_tissue = (ir > 18000) or (red > 12000)

        if not sample_has_tissue:
            self.absent_count += 1
            if self.absent_count >= 8:  # 8 samples * 40ms = 320ms persistent absence
                if self.finger_present:
                    self.reset()
                return False, None, None, 0.0, False, self.beat_count, None, None, None
            # During transient dip, maintain finger presence and hold current vital values!
            return self.finger_present, self.current_bpm, self.current_spo2, self.ac_smooth, False, self.beat_count, self.current_ptt_ms, self.current_sbp, self.current_dbp
        else:
            self.absent_count = 0
            self.finger_present = True

        # 2. Fast DC baseline tracking
        if self.ir_dc is None:
            self.ir_dc = float(ir)
            self.red_dc = float(red)
            return True, None, None, 0.0, False, self.beat_count, None, None, None

        ir_err = abs(float(ir) - self.ir_dc)
        if ir_err > 350.0:
            self.ir_dc = 0.70 * self.ir_dc + 0.30 * float(ir)
            self.red_dc = 0.70 * self.red_dc + 0.30 * float(red)
        else:
            self.ir_dc = 0.93 * self.ir_dc + 0.07 * float(ir)
            self.red_dc = 0.93 * self.red_dc + 0.07 * float(red)

        # 3. AC pulsatile signal
        ac_ir_raw = float(ir) - self.ir_dc
        ac_red_raw = float(red) - self.red_dc

        self.ac_smooth = 0.65 * self.ac_smooth + 0.35 * ac_ir_raw

        # Amplitude clamping to avoid sensor saturation spikes
        clamped_ac_ir = max(0.0, min(300.0, abs(self.ac_smooth)))
        clamped_ac_red = max(0.0, min(300.0, abs(ac_red_raw)))
        self.ir_ac_peak = max(30.0, min(250.0, max(self.ir_ac_peak * 0.985, clamped_ac_ir)))
        self.red_ac_peak = max(30.0, min(250.0, max(self.red_ac_peak * 0.985, clamped_ac_red)))

        # 4. Beat detection (16 samples = 640ms refractory lockout for thumb pad)
        is_ppg_peak = False
        threshold = max(20.0, self.ir_ac_peak * 0.38)
        can_trigger = (self.last_peak_sample is None) or ((self.sample_idx - self.last_peak_sample) >= 16)

        if can_trigger:
            if self.prev_ac > threshold and self.prev_ac >= self.prev_ac2 and self.prev_ac >= self.ac_smooth:
                is_ppg_peak = True
                self.beat_count += 1

                # Heart rate computation from hardware sample intervals
                if self.last_peak_sample is not None:
                    delta_samples = self.sample_idx - self.last_peak_sample
                    dt_ms = delta_samples * self.SAMPLE_PERIOD_MS

                    if 550 <= dt_ms <= 1500:  # 40 to 109 BPM resting range
                        instant_bpm = 60000.0 / dt_ms
                        self.bpm_history.append(instant_bpm)
                        if len(self.bpm_history) > 5:
                            self.bpm_history.pop(0)

                        sorted_bpm = sorted(self.bpm_history)
                        median_bpm = sorted_bpm[len(sorted_bpm) // 2]

                        if self.current_bpm is None:
                            self.current_bpm = median_bpm
                        else:
                            self.current_bpm = 0.75 * self.current_bpm + 0.25 * median_bpm

                        # Calibrated SpO2 formula: SpO2 = 110.0 - 12.0 * R
                        if self.red_dc > 0 and self.ir_dc > 0 and self.ir_ac_peak > 0:
                            r_ratio = (self.red_ac_peak / self.red_dc) / (self.ir_ac_peak / self.ir_dc)
                            calc_spo2 = 110.0 - (12.0 * r_ratio)
                            calc_spo2 = max(88.0, min(99.8, calc_spo2))
                            if self.current_spo2 is None:
                                self.current_spo2 = calc_spo2
                            else:
                                self.current_spo2 = 0.85 * self.current_spo2 + 0.15 * calc_spo2

                # 5. Pulse Transit Time (PTT) Synchronization
                if last_r_peak_ms is not None:
                    ptt_ms = time.ticks_diff(now_ms, last_r_peak_ms)
                    # Physiological hand/thumb PTT range: 160 ms to 420 ms
                    if 160 <= ptt_ms <= 420:
                        self.ptt_history.append(ptt_ms)
                        if len(self.ptt_history) > 5:
                            self.ptt_history.pop(0)

                        avg_ptt = sum(self.ptt_history) / len(self.ptt_history)
                        self.current_ptt_ms = round(avg_ptt, 1)

                        # Calculate Blood Pressure via Moens-Korteweg model
                        log_ptt = math.log(avg_ptt)
                        calc_sbp = (self.cal_a * log_ptt) + self.cal_b
                        calc_dbp = (self.cal_c * log_ptt) + self.cal_d

                        sbp_val = max(85, min(190, int(round(calc_sbp))))
                        dbp_val = max(50, min(120, int(round(calc_dbp))))

                        if self.current_sbp is None:
                            self.current_sbp = sbp_val
                            self.current_dbp = dbp_val
                        else:
                            self.current_sbp = int(round(0.70 * self.current_sbp + 0.30 * sbp_val))
                            self.current_dbp = int(round(0.70 * self.current_dbp + 0.30 * dbp_val))

                self.last_peak_sample = self.sample_idx

        self.prev_ac2 = self.prev_ac
        self.prev_ac = self.ac_smooth

        return (
            True,
            self.current_bpm,
            self.current_spo2,
            self.ac_smooth,
            is_ppg_peak,
            self.beat_count,
            self.current_ptt_ms,
            self.current_sbp,
            self.current_dbp
        )

# ==============================================================================
# 5. Main Program Execution Loop
# ==============================================================================

def main():
    print("=" * 68)
    print("  ESP32-CAM Precision Vital Signs Station + Blood Pressure")
    print("  Sensors: MAX30102 (PPG) + AD8232 (ECG) + LCD 1602 (I2C)")
    print("  Calibrated to: 60 BPM | 99% SpO2 | Moens-Korteweg PTT BP")
    print("=" * 68)

    # Initialize shared I2C bus: GPIO 14 (SCL), GPIO 13 (SDA)
    i2c = SoftI2C(scl=Pin(14), sda=Pin(13), freq=100000)
    devices = i2c.scan()
    print("[INFO] I2C Scan detected devices:", [hex(d) for d in devices])

    # 1. Initialize LCD 1602 Display (if connected at 0x27 or 0x3F)
    lcd = None
    for addr in LCD_ADDR_CANDIDATES:
        if addr in devices:
            try:
                lcd = I2cLcd1602(i2c, addr=addr)
                print("[OK] LCD 1602 initialized at address %s" % hex(addr))
                lcd.set_cursor(0, 0)
                lcd.write_str("VITAL SIGNS MON ")
                lcd.set_cursor(0, 1)
                lcd.write_str("ECG+PPG+BP READY")
                time.sleep_ms(600)
                break
            except Exception as e:
                print("[WARN] LCD init error:", e)

    # 2. Initialize MAX30102 Sensor
    if MAX30102_ADDR not in devices:
        print("[ERROR] MAX30102 (0x57) not found! Check wiring on GPIO 14 (SCL) and GPIO 13 (SDA).")
        if lcd:
            lcd.set_cursor(0, 0)
            lcd.write_str("SENSOR ERROR!   ")
            lcd.set_cursor(0, 1)
            lcd.write_str("CHECK MAX30102  ")
        return

    sensor = MAX30102(i2c)

    # 3. Initialize AD8232 ECG on GPIO 2 (ADC2_CH2 - Pin 7 on Left Header)
    print("[OK] Initializing AD8232 ECG on GPIO 2 (ADC2_CH2 - Left Header Pin 7)...")
    ecg = EcgEngine(adc_pin=2)

    vitals = VitalsAndBPEngine()

    if lcd:
        lcd.set_cursor(0, 0)
        lcd.write_str("VITAL SIGNS MON ")
        lcd.set_cursor(0, 1)
        lcd.write_str("PLACE THUMB...  ")

    print("\n[READY] System online!")
    print(" -> Attach AD8232 ECG electrodes (RA: Right Arm, LA: Left Arm, RL: Reference)")
    print(" -> Place thumb pad gently on MAX30102 sensor\n")

    BAR_WIDTH = 18
    sample_counter = 0
    last_lcd_update = time.ticks_ms()
    last_terminal_update = time.ticks_ms()
    last_beat_display = 0
    last_finger_seen_ms = 0
    latest_ir = 0

    has_finger = False
    bpm = None
    spo2 = None
    ac_val = 0.0
    ptt_ms = None
    sbp = None
    dbp = None
    beat_num = 0

    while True:
        try:
            now_ms = time.ticks_ms()

            # 1. Continuous ECG Sampling on GPIO 2
            raw_ecg, is_r_peak, leads_ok = ecg.sample(now_ms)
            if is_r_peak:
                last_beat_display = now_ms

            # 2. Read available samples from MAX30102 FIFO
            is_ppg_beat = False
            num_avail = sensor.available()

            # Process up to 8 samples per tick (maintains smooth 25Hz rate without lag)
            for _ in range(min(num_avail, 8)):
                red, ir = sensor.read_sample()
                if red is None or ir is None:
                    continue

                latest_ir = ir
                res = vitals.process_ppg(red, ir, ecg.last_r_peak_ms, now_ms)
                (
                    cur_finger,
                    cur_bpm,
                    cur_spo2,
                    cur_ac,
                    beat_flag,
                    cur_bnum,
                    cur_ptt,
                    cur_sbp,
                    cur_dbp
                ) = res

                has_finger = cur_finger
                if cur_finger:
                    last_finger_seen_ms = now_ms

                if cur_bpm is not None:
                    bpm = cur_bpm
                if cur_spo2 is not None:
                    spo2 = cur_spo2
                ac_val = cur_ac
                if cur_ptt is not None:
                    ptt_ms = cur_ptt
                if cur_sbp is not None:
                    sbp = cur_sbp
                    dbp = cur_dbp
                beat_num = cur_bnum

                if beat_flag:
                    is_ppg_beat = True
                    last_beat_display = now_ms

            # 1.5-second display hold prevents pulse systolic dips from flickering UI
            finger_active = has_finger or (time.ticks_diff(now_ms, last_finger_seen_ms) < 1500)

            # 3. Terminal Oscilloscope Trace (Independent timer: every 100ms or on beat)
            sample_counter += 1
            terminal_due = (time.ticks_diff(now_ms, last_terminal_update) >= 100)
            if terminal_due or is_ppg_beat or is_r_peak:
                last_terminal_update = now_ms

                if not finger_active:
                    # When thumb is away: display continuous live ECG readings!
                    lead_txt = "[LEADS OK]" if leads_ok else "[LEADS OFF]"
                    ecg_hr_txt = ("%5.1f BPM" % ecg.ecg_bpm) if ecg.ecg_bpm else "  -- BPM "
                    peak_txt = " *R-PEAK*" if is_r_peak else "         "
                    print("|  ADC:%4d %-10s | %s | IR:%6d | --.-%% SpO2 | BP: PLACE THUMB %s" % (
                        raw_ecg, lead_txt, ecg_hr_txt, latest_ir, peak_txt
                    ))
                else:
                    pos = int(9 + (ac_val / 16.0))
                    pos = max(0, min(BAR_WIDTH - 1, pos))
                    bar = [' '] * BAR_WIDTH
                    bar[pos] = '#'
                    trace = "".join(bar)

                    bpm_str = ("%5.1f BPM" % bpm) if bpm is not None else "   -- BPM "
                    spo2_str = ("%4.1f%% SpO2" % spo2) if spo2 is not None else " --.-% SpO2"

                    if sbp is not None and dbp is not None and ptt_ms is not None:
                        bp_str = "BP:%3d/%-2d (%dms)" % (sbp, dbp, int(ptt_ms))
                    elif leads_ok:
                        bp_str = "BP: SYNCING...  "
                    else:
                        bp_str = "BP: (NO ECG LEAD)"

                    beat_str = ("<3 BEAT #%d!" % beat_num) if is_ppg_beat else (" *R-PEAK*  " if is_r_peak else "           ")
                    print("|" + trace + "| " + bpm_str + " | " + spo2_str + " | " + bp_str + " " + beat_str)

            # 4. LCD 1602 Display Updates (Independent timer: every 220ms or on beat)
            lcd_due = (time.ticks_diff(now_ms, last_lcd_update) >= 220)
            if lcd and (lcd_due or is_ppg_beat or is_r_peak):
                last_lcd_update = now_ms
                is_pulsing = (now_ms - last_beat_display < 220)

                # Row 0: Primary Vital Signs (Rock-steady display, never flickers)
                lcd.set_cursor(0, 0)
                if finger_active and bpm:
                    spo2_val = ("%2.0f%%" % spo2) if spo2 else "--%"
                    row0_text = "HR:%4.0f SpO2:%-3s" % (bpm, spo2_val)
                    lcd.write_str(row0_text[:15])
                elif ecg.ecg_bpm:
                    lcd.write_str("ECG : %5.1f BPM " % ecg.ecg_bpm)
                else:
                    lcd.write_str("VITAL SIGNS MON ")

                # Heart icon in top-right corner (character 15)
                lcd.set_cursor(15, 0)
                if is_pulsing:
                    lcd.write_custom(0)
                else:
                    lcd.write_str(" ")

                # Row 1: Blood Pressure or Status (Deterministic & stable)
                lcd.set_cursor(0, 1)
                if finger_active:
                    if sbp is not None and dbp is not None:
                        lcd.write_str("BP:%3d/%-2d %3dms" % (sbp, dbp, int(ptt_ms or 0)))
                    else:
                        lcd.write_str("BP: SYNCING PTT ")
                else:
                    lcd.write_str("PLACE THUMB PAD ")

            # Small sleep to prevent tight CPU spin
            time.sleep_ms(6)

        except Exception as e:
            # Prevent any transient error from stopping the program
            time.sleep_ms(20)

if __name__ == "__main__":
    main()